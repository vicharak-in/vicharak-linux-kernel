/*
 * Copyright (C) 2026 Vicharak Computers Pvt. Ltd.

 Axon CM Evolution Board 1 (EVB1) Includes:
 - 1x HDMI Tx0
 - 1x USB 2.0
 - 1x PCIe 2.0 on B Key
 - 1x USB 3.0 on B Key
 - 1x Audio Jack ES8388
 - 2x Audio Speaker ( Left and Right )
 - 1x Ethernet RGMII
 - 1x MIPI DPHY DSI
 - 1x Controller area network (CAN)
 - 1x Button each for POWER, RESET and BOOT
 - 1x Sim Card Slot
 - 1x Battery Charging IC (BQ25792RQMR)
 - 1x 1.8v connector
 - 1x 3.3v connector
 - 1x 5v connector
 */

#include "rk3588-axon-cm.dtsi"
#include "rk3588-linux.dtsi"
#include <dt-bindings/input/rk-input.h>

/ {

	es8388_sound: es8388-sound {
		compatible = "rockchip,multicodecs-card";
		hp-con-gpio = <&gpio1 RK_PD5 GPIO_ACTIVE_HIGH>;
		hp-det-gpio = <&gpio1 RK_PC4 GPIO_ACTIVE_HIGH>;
		spk-con-gpio = <&gpio1 RK_PC6 GPIO_ACTIVE_HIGH>;
		io-channel-names = "adc-detect";
		io-channels = <&saradc 3>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;
		rockchip,audio-routing =
			"Headphone", "LOUT1",
			"Headphone", "ROUT1",
			"Speaker", "LOUT2",
			"Speaker", "ROUT2",
			"Headphone", "Headphone Power",
			"Headphone", "Headphone Power",
			"Speaker", "Speaker Power",
			"Speaker", "Speaker Power",
			"RINPUT1", "Headset Mic",
			"RINPUT2", "Headset Mic";
		rockchip,card-name = "rockchip-es8388";
		rockchip,codec = <&es8388>;
		rockchip,cpu = <&i2s0_8ch>;
		rockchip,format = "i2s";
		rockchip,mclk-fs = <256>;
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det &amp_ctrl>;
		status = "okay";

		play-pause-key {
			label = "playpause";
			linux,code = <KEY_PLAYPAUSE>;
			press-threshold-microvolt = <2000>;
		};
	};

	pcie20_avdd0v85: pcie20-avdd0v85-regulator {
		compatible = "regulator-fixed";
		regulator-name = "pcie20_avdd0v85";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <850000>;
		vin-supply = <&vdd_0v75_s0>;
	};

	pcie20_avdd1v8: pcie20-avdd1v8-regulator {
		compatible = "regulator-fixed";
		regulator-name = "pcie20_avdd1v8";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&avcc_1v8_s0>;
	};

	vcc3v3_pcie20_sata30: vcc3v3-pcie20-sata30 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie20_sata30";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb20_host: vcc5v0-usb20-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb20_host";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc0_5v0>;
	};
};

&can2 {
	status = "okay";
};

&combphy1_ps {
	status = "okay";
};

&gmac1 {
    clock_in_out = "output";
    phy-handle = <&rgmii_phy>;
    phy-mode = "rgmii-rxid";
    phy-supply = <&vcc_3v3_s3>;
    pinctrl-0 = <&gmac1_rgmii_bus
                &gmac1_rgmii_clk
                &gmac1_rx_bus2
                &gmac1_tx_bus2
                &gmac1_miim>;
    pinctrl-names = "default";
    snps,reset-active-low;
    snps,reset-delays-us = <0 20000 100000>;
    snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
    rx_delay = <0x00>;
    tx_delay = <0x43>;
    status = "okay";
};

&hdmi0 {
	enable-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_HIGH>;
	cec-enable;
	status = "okay";
};

&hdmi0_in_vp0 {
	status = "okay";
};

&hdptxphy_hdmi0 {
	status = "okay";
};

&vp0_out_hdmi0 {
	status = "okay";
};
&i2c3 {
	status = "okay";

	es8388: es8388@11 {
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x11>;
		clocks = <&mclkout_i2s0>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_i2s0>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2s0_mclk>;
		DVDD-supply = <&vcc_1v8_s0>;
		AVDD-supply = <&vcc_3v3_s0>;
		PVDD-supply = <&vcc_1v8_s0>;
		HPVDD-supply = <&vcc_3v3_s0>;
		status = "okay";
	};
};

&i2s0_8ch {
	pinctrl-0 = <&i2s0_lrck
				&i2s0_sclk
				&i2s0_sdi0
				&i2s0_sdo0>;

	status = "okay";
};

&mdio1 {
    rgmii_phy: phy@1 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0x1>;
    };
};

&pcie2x1l0 {
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2_0_rst &pcie2_0_clkreq &pcie2_0_wake>;
	rockchip,skip-scan-in-resume;
	status = "okay";
};

&pinctrl {

	amplifier_ctrl {
		amp_ctrl: amp-ctrl {
			rockchip,pins =
				<4 RK_PD4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	headphone {
		hp_det: hp-det {
			rockchip,pins =
				<1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcie2 {
		pcie2_0_rst: pcie2-0-rst {
			rockchip,pins =
				<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie2_0_clkreq: pcie2-0-clkreq {
			rockchip,pins =
				<4 RK_PA0 4 &pcfg_pull_none>;
		};

		pcie2_0_wake: pcie2-0-wake {
			rockchip,pins =
				<4 RK_PA1 4 &pcfg_pull_none>;
		};
	};
};

&saradc {
	vref-supply = <&avcc_1v8_s0>;
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	phy-supply = <&vcc5v0_usb20_host>;
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	phy-supply = <&vcc5v0_usb20_host>;
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};
