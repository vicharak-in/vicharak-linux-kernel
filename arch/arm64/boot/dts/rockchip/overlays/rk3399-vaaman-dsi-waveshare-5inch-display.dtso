/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/display/drm_mipi_dsi.h>

&{/} {
	metadata {
		title = "Enable Waveshare 5inch DSI LCD";
		compatible = "vicharak,rk3399-vaaman", "rockchip,rk3399";
		category = "display";
		exclusive = "dsi", "hdmi", "cdn_dp";
		description = "Enables support for the Waveshare 5-inch DSI LCD screen.\nPlease note that HDMI/DP output will be disabled as a result.";
	};
};

&dsi {
	status = "okay";
	rockchip,lane-rate = <670>;
	#address-cells = <1>;
	#size-cells = <0>;

    panel: panel-dsi-generic@0 {
        compatible = "simple-panel-dsi";
        reg = <0>;
        power-supply = <&reg_display>;
        backlight = <&reg_display>;
        status = "okay";
		init-delay-ms = <30>;

        width-mm = <0>;
        height-mm = <0>;

        dsi,format = <MIPI_DSI_FMT_RGB888>;
        dsi,lanes = <1>;
        dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
              MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_VIDEO_HSE)>;

        display-timings {
            native-mode = <&timing0>;
            timing0: timing0 {
                clock-frequency = <27778000>;
                hactive = <800>;
                vactive = <480>;

                hback-porch = <45>;
                hfront-porch = <59>;

                vback-porch = <22>;
                vfront-porch = <7>;

                hsync-len = <2>;
                vsync-len = <2>;
            };
        };

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                panel_in_dsi: endpoint {
                    remote-endpoint = <&dsi_out_panel>;
                };
            };
        };
    };

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};

&i2c1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	reg_display: reg_display@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
		status = "okay";
	};

	ft5406: ts@38 {
		compatible = "edt,edt-ft5506";
		reg = <0x38>;
		vcc-supply = <&reg_display>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
		touchscreen-inverted-x;
		touchscreen-inverted-y;
		status = "okay";
	};
};

&dsi_in_vopl {
	status = "disabled";
};

&dsi_in_vopb {
	status = "okay";
};

&dp_in_vopb {
	status = "disabled";
};

&edp_in_vopb {
	status = "disabled";
};

&hdmi_in_vopb {
	status = "disabled";
};

&route_dsi {
	status = "okay";
	connect = <&dsi_in_vopb>;
};

&route_hdmi {
	status = "disabled";
};

&hdmi {
	status = "disabled";
};

&hdmi_sound {
	status = "disabled";
};

&cdn_dp {
	status = "disabled";
};
