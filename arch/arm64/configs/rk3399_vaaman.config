# Enable board support
CONFIG_BOARD_VICHARAK_VAAMAN=y

# Enable RTL8822CS Wi-Fi support
CONFIG_RTL8822CS=m

# Disable unused UART BT drivers
# CONFIG_BT_HCIUART_3WIRE is not set
# CONFIG_BT_HCIUART_BCM is not set
# CONFIG_BT_HCIUART_H4 is not set
# CONFIG_BT_HCIUART_LL is not set
# CONFIG_BT_HCIUART_MRVL is not set
# CONFIG_BT_HCIUART_NOKIA is not set
# CONFIG_BT_HCIUART_QCA is not set
# CONFIG_BT_HCIUART_RTL is not set
# CONFIG_BT_MTKUART is not set
# CONFIG_BT_RTK_HCIUART_H4 is not set

# Disable Rave SP MCU core support
# CONFIG_RAVE_SP_CORE is not set

# Disable PMS7003 support
# CONFIG_PMS7003 is not set

# Enable Realtek UART bluetooth support
CONFIG_RTKBT_UART=y

# Enable serial device bus support
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# Enable PCA953X GPIO expander support
CONFIG_GPIO_PCA953X=y
# CONFIG_GPIO_PCA953X_IRQ is not set

# Enable overlay support
CONFIG_OF_OVERLAY=y

# Enable overlay fs support
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_REDIRECT_ALWAYS_FOLLOW=y
# CONFIG_OVERLAY_FS_INDEX is not set
# CONFIG_OVERLAY_FS_XINO_AUTO is not set
# CONFIG_OVERLAY_FS_METACOPY is not set

# Enable Virtual camera support
CONFIG_VIDEO_VIRT_CAMERA=y

# Disable unused MALI GPU drivers
# CONFIG_MALI400 is not set
# CONFIG_MALI450 is not set
# CONFIG_MALI_BIFROST is not set

# Build Rockchip PCIe drivers as module
CONFIG_PCIE_ROCKCHIP_HOST=m
CONFIG_PCIE_DW_ROCKCHIP=m

# Enable FPGA PMIC support
CONFIG_REGULATOR_MP5416=y

# Enable PERIPLEX support
CONFIG_PERIPLEX=y

#Enable PERIPLEX_UART support
CONFIG_PERIPLEX_UART=m

#Enable PERIPLEX_I2C support
CONFIG_PERIPLEX_I2C=m

#Enable PERIPLEX_GPIO support
CONFIG_PERIPLEX_GPIO=m

#Enable PERIPLEX_PWM support
CONFIG_PERIPLEX_PWM=m

#Enable PERIPLEX_SPI support
CONFIG_PERIPLEX_SPI=m

#Enable PERIPLEX_I2S support
CONFIG_PERIPLEX_I2S=m

#Enable PERIPLEX_ONEWIRE support
CONFIG_PERIPLEX_ONEWIRE=m

#Enable PERIPLEX_CAN support
CONFIG_PERIPLEX_CAN=m

#Enable PERIPLEX_DHT support
CONFIG_PERIPLEX_DHT=m

#Enable PERIPLEX_WS2812B support
CONFIG_PERIPLEX_WS2812B=m